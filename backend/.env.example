# Database
DATABASE_URL=postgresql+asyncpg://arbitrage_user:strong_password_here@postgres:5432/arbitrage_betting

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Security
SECRET_KEY=your-secret-key-change-in-production-min-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Scraping Settings
SCRAPE_INTERVAL_SECONDS=5
MAX_CONCURRENT_SCRAPERS=10

# Arbitrage Settings
MIN_PROFIT_PERCENTAGE=1.0
MAX_ARBITRAGE_AGE_SECONDS=30

# Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ENABLE_EMAIL_ALERTS=false
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587

# Bookmakers (comma-separated)
BOOKMAKERS=bet365,betano,betway,rivalo,novibet,betsson,betmgm
